{
  "workspace": [
    "./web/client",
    "./web/server",
    "./web/tests"
  ],
  "tasks": {
    "build:wasm": {
      "description": "Builds the engine and CPU wasm modules into web/client/static/wasm",
      "command": "cd wasm && cargo build --release --target wasm32-unknown-unknown && cd .. && mkdir -p web/client/static/wasm && cp wasm/target/wasm32-unknown-unknown/release/graph_go_engine.wasm web/client/static/wasm/engine.wasm && cp wasm/target/wasm32-unknown-unknown/release/graph_go_cpu.wasm web/client/static/wasm/cpu.wasm"
    },
    "dev": {
      "dependencies": [
        "build:wasm"
      ],
      "command": "deno task --cwd web/server dev"
    },
    "serve": {
      "dependencies": [
        "build:wasm"
      ],
      "command": "deno task --cwd web/server serve"
    },
    "build": {
      "dependencies": [
        "build:wasm"
      ],
      "command": "deno task --cwd web/server build"
    },
    "test": {
      "dependencies": [
        "build:wasm"
      ],
      "command": "deno test -P --ignore=web/tests"
    },
    "test:wasm": {
      "description": "The Rust unit tests",
      "command": "cd wasm && cargo fmt --check && cargo test"
    },
    "test:browser": "deno task --cwd web/tests test",
    "check": "deno task --cwd web/client check && deno task --cwd web/server check && deno lint && deno fmt --check"
  },
  "permissions": {
    "default": {
      "read": true,
      "env": true,
      "net": [
        "id.kbn.one",
        "localhost",
        "127.0.0.1"
      ],
      "import": true
    }
  },
  "test": {
    "permissions": "default"
  },
  "nodeModulesDir": "auto",
  "minimumDependencyAge": {
    "age": "P1D",
    "exclude": [
      "jsr:@kuboon/*",
      "jsr:@remix-kbn/*",
      "npm:@remix-run/*"
    ]
  },
  "unstable": [
    "bundle",
    "kv"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@remix-run/component"
  },
  "imports": {
    "@kuboon/dpop": "jsr:@kuboon/dpop@^0.1.2",
    "@kuboon/md": "jsr:@kuboon/md@^0.7.0",
    "@kuboon/share-element": "jsr:@kuboon/share-element@^0.5.0",
    "@lightpanda/browser": "npm:@lightpanda/browser@^1.2.0",
    "@remix-kbn/assets-deno": "jsr:@remix-kbn/assets-deno@^0.9.0",
    "@remix-kbn/helper-agent/agent/dummy": "jsr:@remix-kbn/helper-agent@^0.3.0/agent/dummy",
    "@remix-kbn/helper-agent/client": "jsr:@remix-kbn/helper-agent@^0.3.0/client",
    "@remix-kbn/helper-agent/controller": "jsr:@remix-kbn/helper-agent@^0.3.0/controller",
    "@remix-kbn/ssg": "jsr:@remix-kbn/ssg@^0.13.0",
    "@remix-run/component": "npm:@remix-run/component@^1.0.0",
    "@remix-run/fetch-router": "npm:@remix-run/fetch-router@^1.0.0",
    "@remix-run/render-middleware": "npm:@remix-run/render-middleware@^1.0.0",
    "@remix-run/spa": "npm:@remix-run/spa@^1.0.0",
    "@remix-run/ui": "npm:@remix-run/ui@^0.12.1",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/front-matter": "jsr:@std/front-matter@^1.0.9",
    "canvaskit-wasm": "npm:canvaskit-wasm@^0.40.0",
    "puppeteer-core": "npm:puppeteer-core@^23.11.1"
  },
  "allowScripts": {
    "allow": [
      "npm:@lightpanda/browser@1.2.0"
    ]
  },
  "fmt": {
    "exclude": [
      "web/dist",
      "node_modules",
      "wasm/target",
      "web/client/static/wasm"
    ]
  },
  "lint": {
    "exclude": [
      "web/dist",
      "node_modules",
      "wasm/target",
      "web/client/static/wasm"
    ]
  }
}
