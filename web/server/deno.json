{
  "tasks": {
    "dev": "deno serve -P=dev --watch --port 8000 router.tsx",
    "serve": "deno serve -P=dev router.tsx",
    "build": "deno run -c deno.json -P=build jsr:@remix-kbn/ssg/build.ts --out ../dist",
    "check": "deno check ."
  },
  "permissions": {
    "build": {
      "read": [
        "../.."
      ],
      "write": [
        "../dist"
      ],
      "env": {
        "allow": [
          "BASE_URL"
        ],
        "ignore": [
          "NODE_ENV",
          "VSCODE_TEXTMATE_DEBUG",
          "IDP_ORIGIN"
        ]
      },
      "import": true
    },
    "dev": {
      "read": [
        "../.."
      ],
      "env": {
        "allow": [
          "PORT",
          "IDP_ORIGIN"
        ],
        "ignore": [
          "BASE_URL",
          "NODE_ENV",
          "VSCODE_TEXTMATE_DEBUG"
        ]
      },
      "net": [
        "0.0.0.0",
        "127.0.0.1",
        "localhost",
        "id.kbn.one"
      ],
      "import": true
    }
  },
  "compilerOptions": {
    "lib": [
      "deno.ns",
      "deno.unstable",
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "@remix-run/component"
  }
}
